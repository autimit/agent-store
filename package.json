{
  "name": "agent-store",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint -c glaze.eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "auth:migrate": "node auth/server.mjs --migrate",
    "auth:start": "node auth/server.mjs",
    "test:auth": "node --test --test-isolation=none auth/auth.test.mjs",
    "check:design": "node scripts/legacy.mjs --zero import,mixed,raw,palette"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
