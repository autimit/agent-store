        "required": [
          "full_name",
          "email",
          "postal_code",
          "street",
          "number",
          "neighborhood",
          "city",
          "state"
        ],
        "additionalProperties": false
      },
      "ShippingQuoteRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "postal_code": {
            "type": "string",
            "pattern": "^[0-9]{5}-?[0-9]{3}$"
          }
        },
        "required": [
          "items",
          "postal_code"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "checkoutToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "access_token retornado na criação; autoriza apenas o checkout correspondente."
      },
      "StoreSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Sessão de navegador gerenciada pelo Better Auth. Em HTTPS a biblioteca pode usar prefixo de cookie seguro. Tokens de checkout isolados não substituem login nem permitem acessar compras de outra conta."
      }
    }
  }
}
