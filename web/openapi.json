            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShippingOption"
            }
          },
          "currency": {
            "const": "BRL"
          },
          "demo": {
            "const": true
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "postal_code",
          "options",
          "currency",
          "demo",
          "note"
        ],
        "additionalProperties": false
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "minLength": 0,
            "maxLength": 25
          },
          "postal_code": {
            "type": "string",
            "pattern": "^[0-9]{5}-?[0-9]{3}$"
          },
          "street": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "complement": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "neighborhood": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "state": {
            "type": "string",
            "description": "UF brasileira com duas letras.",
            "enum": [
              "AC",
              "AL",
              "AP",
              "AM",
              "BA",
              "CE",
              "DF",
              "ES",
              "GO",
              "MA",
              "MT",
              "MS",
              "MG",
              "PA",
              "PB",
