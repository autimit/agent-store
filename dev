#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
task_go_bin="${AGENT_STORE_GO_BIN:-}"
if [ -z "$task_go_bin" ]; then
  if command -v go >/dev/null 2>&1; then task_go_bin="$(command -v go)";
  elif [ -x /tmp/haseo-bootstrap/go/bin/go ]; then
    task_go_bin=/tmp/haseo-bootstrap/go/bin/go
    export GOPATH="${GOPATH:-/tmp/haseo-bootstrap/gopath}"
    export GOCACHE="${GOCACHE:-/tmp/haseo-bootstrap/cache}"
  else printf '%s\n' 'Instale Go 1.26+ ou configure AGENT_STORE_GO_BIN.' >&2; exit 1; fi
fi
if [ ! -d node_modules ]; then npm ci; fi
npm run build
mkdir -p bin
"$task_go_bin" build -o bin/agent-store ./cmd/agent-store
exec ./bin/agent-store "$@"
